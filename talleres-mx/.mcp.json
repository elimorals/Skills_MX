{
  "_comment": "MCP servers para talleres-mx. banxico activo por default; el resto requiere credenciales.",
  "mcpServers": {
    "banxico": {
      "_comment": "Tipos de cambio DOF para cotizar refacciones importadas o autos de extranjeros.",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_banxico.server"
      ],
      "env": {
        "BANXICO_TOKEN": "${BANXICO_TOKEN:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    },
    "facturama": {
      "_comment": "MCP propio mp_facturama_extendido: validación local + timbrado CFDI 4.0 para servicios + refacciones.",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_facturama_extendido.server"
      ],
      "env": {
        "FACTURAMA_USER": "${FACTURAMA_USER:-}",
        "FACTURAMA_PASSWORD": "${FACTURAMA_PASSWORD:-}",
        "FACTURAMA_ENV": "${FACTURAMA_ENV:-sandbox}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    },
    "mercadopago": {
      "_comment": "MCP propio mp_mercado_pago: payment links para anticipos + cobro al recoger auto, webhook validation.",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_mercado_pago.server"
      ],
      "env": {
        "MERCADOPAGO_ACCESS_TOKEN": "${MERCADOPAGO_ACCESS_TOKEN:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    },
    "mercadolibre": {
      "_comment": "MCP propio mp_mercado_libre: gestión de listings, precios, stock, órdenes y mensajes ML. Útil si el taller vende refacciones.",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_mercado_libre.server"
      ],
      "env": {
        "ML_APP_ID": "${ML_APP_ID:-}",
        "ML_SECRET": "${ML_SECRET:-}",
        "ML_REFRESH_TOKEN": "${ML_REFRESH_TOKEN:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    },
    "stripe": {
      "_comment": "Cobro con tarjeta y links de pago.",
      "command": "npx",
      "args": [
        "-y",
        "@stripe/mcp",
        "--tools=all"
      ],
      "disabled": true,
      "env": {
        "STRIPE_SECRET_KEY": "${STRIPE_SECRET_KEY:-}"
      }
    }
  }
}
