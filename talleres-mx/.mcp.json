{
  "_comment": "MCP servers para talleres-mx. banxico activo por default; el resto requiere credenciales.",
  "mcpServers": {
    "banxico": {
      "_comment": "Tipos de cambio DOF para cotizar refacciones importadas o autos de extranjeros.",
      "command": ".venv/bin/python",
      "args": ["-m", "mp_banxico.server"],
      "cwd": "/Users/elias/Documents/Trabajo/skills/mcp-servers",
      "env": {
        "BANXICO_TOKEN": "${BANXICO_TOKEN:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    },
    "facturama": {
      "_comment": "MCP propio mp_facturama_extendido: validación local + timbrado CFDI 4.0 para servicios + refacciones.",
      "command": ".venv/bin/python",
      "args": ["-m", "mp_facturama_extendido.server"],
      "cwd": "/Users/elias/Documents/Trabajo/skills/mcp-servers",
      "env": {
        "FACTURAMA_USER": "${FACTURAMA_USER:-}",
        "FACTURAMA_PASSWORD": "${FACTURAMA_PASSWORD:-}",
        "FACTURAMA_ENV": "${FACTURAMA_ENV:-sandbox}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    },
    "mercadopago": {
      "_comment": "MCP propio mp_mercado_pago: payment links para anticipos + cobro al recoger auto, webhook validation. Mock-friendly.",
      "command": ".venv/bin/python",
      "args": ["-m", "mp_mercado_pago.server"],
      "cwd": "/Users/elias/Documents/Trabajo/skills/mcp-servers",
      "env": {
        "MERCADOPAGO_ACCESS_TOKEN": "${MERCADOPAGO_ACCESS_TOKEN:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    },
    "whatsapp-business": {
      "_comment": "Para autorización + comunicación cliente.",
      "command": "npx",
      "args": ["-y", "@gupshup/mcp-whatsapp"],
      "env": {
        "GUPSHUP_API_KEY": "${GUPSHUP_API_KEY:-mock}"
      },
      "disabled": true
    },
    "mercadolibre": {
      "_comment": "MCP propio mp_mercado_libre: gestión de listings, precios, stock, órdenes y mensajes ML. Útil si el taller vende refacciones. Mock-friendly.",
      "command": ".venv/bin/python",
      "args": ["-m", "mp_mercado_libre.server"],
      "cwd": "/Users/elias/Documents/Trabajo/skills/mcp-servers",
      "env": {
        "ML_APP_ID": "${ML_APP_ID:-}",
        "ML_SECRET": "${ML_SECRET:-}",
        "ML_REFRESH_TOKEN": "${ML_REFRESH_TOKEN:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    },
    "stripe": {
      "_comment": "Cobro con tarjeta y links de pago.",
      "command": "npx",
      "args": ["-y", "@stripe/mcp-server"],
      "env": {
        "STRIPE_API_KEY": "${STRIPE_API_KEY:-mock}"
      },
      "disabled": true
    }
  }
}
