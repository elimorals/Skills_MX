{
  "_comment": "MCP servers para freelancers-mx. El resto requiere credenciales.",
  "mcpServers": {
    "banxico": {
      "_comment": "Tipos de cambio DOF para CFDI multimoneda (cliente extranjero, exportación servicios).",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_banxico.server"
      ],
      "env": {
        "BANXICO_TOKEN": "${BANXICO_TOKEN:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    },
    "facturama": {
      "_comment": "MCP propio mp_facturama_extendido: validación local + timbrado + cancelación.",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_facturama_extendido.server"
      ],
      "env": {
        "FACTURAMA_USER": "${FACTURAMA_USER:-}",
        "FACTURAMA_PASSWORD": "${FACTURAMA_PASSWORD:-}",
        "FACTURAMA_ENV": "${FACTURAMA_ENV:-sandbox}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    },
    "mercadopago": {
      "_comment": "MCP propio mp_mercado_pago: payment links + webhook validation + refunds.",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_mercado_pago.server"
      ],
      "env": {
        "MERCADOPAGO_ACCESS_TOKEN": "${MERCADOPAGO_ACCESS_TOKEN:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    },
    "banxico_cep": {
      "_comment": "MCP propio mp_banxico_cep: validación CLABE + CEP (Constancia Pago Electrónico SPEI). 4 de 8 tools son 100% locales (CLABE, parseo). Crítico para conciliación cobros SPEI ↔ CFDIs en cierre fiscal mensual.",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_banxico_cep.server"
      ],
      "env": {
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}",
        "BANXICO_CEP_PLAYWRIGHT": "${BANXICO_CEP_PLAYWRIGHT:-}"
      },
      "disabled": false
    },
    "notion": {
      "_comment": "CRM ligero para fichas de cliente. Opcional.",
      "command": "npx",
      "args": [
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "env": {
        "NOTION_TOKEN": "${NOTION_TOKEN:-}"
      },
      "disabled": true
    },
    "stripe": {
      "_comment": "Para cobranza con tarjeta o suscripciones. Opcional.",
      "command": "npx",
      "args": [
        "-y",
        "@stripe/mcp",
        "--tools=all"
      ],
      "disabled": true,
      "env": {
        "STRIPE_SECRET_KEY": "${STRIPE_SECRET_KEY:-}"
      }
    }
  }
}
