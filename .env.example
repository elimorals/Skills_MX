# .env.example — copia a .env y rellena con tus credenciales reales.
#
# IMPORTANTE: .env va en .gitignore — nunca lo commitees.
#
# Sin credenciales setadas, los MCPs corren en modo MOCK con respuestas
# sintéticas marcadas `simulated: true`. Útil para desarrollo y pruebas.

# ====================================
# Modo MOCK global (override)
# ====================================
# Si está en "1", fuerza modo mock en TODOS los MCPs aunque tengas credenciales.
# Útil para tests deterministas.
# PLUGINS_MX_MOCK=1


# ====================================
# Facturama — PAC para timbrado de CFDI
# ====================================
# Opción A: usuario + password de tu cuenta Facturama
# FACTURAMA_USER=tu_correo_o_usuario
# FACTURAMA_PASSWORD=tu_password

# Opción B: API key (algunos planes Facturama)
# FACTURAMA_USER=tu_api_key
# FACTURAMA_PASSWORD=tu_api_key

# Entorno: sandbox o production (default: sandbox)
# Sandbox es gratis. Production cuesta $0.50-$3 MXN por timbre.
# FACTURAMA_ENV=sandbox

# Validar credenciales: python scripts/validar_facturama_credenciales.py


# ====================================
# Banxico — tipos de cambio DOF
# ====================================
# Token gratuito en https://www.banxico.org.mx/SieAPIRest/service/v1/token
# BANXICO_TOKEN=tu_token_aqui


# ====================================
# Mercado Pago — pasarela
# ====================================
# Sandbox: TEST-xxx, Producción: APP_USR-xxx (detectado automáticamente)
# MERCADOPAGO_ACCESS_TOKEN=TEST-1234-5678-90abc-def
# MERCADOPAGO_WEBHOOK_SECRET=tu_webhook_secret


# ====================================
# Conekta — pasarela alternativa MX
# ====================================
# Sandbox: key_test_xxx, Producción: key_live_xxx
# CONEKTA_API_KEY=key_test_xxxxxxxx
# CONEKTA_WEBHOOK_SECRET=tu_webhook_secret


# ====================================
# Mercado Libre — marketplace
# ====================================
# App registrada en https://developers.mercadolibre.com.mx/
# ML_APP_ID=tu_app_id
# ML_SECRET=tu_secret
# ML_REFRESH_TOKEN=token_del_vendedor


# ====================================
# SAT Portal (Playwright/scraping)
# ====================================
# Path real requiere e.firma (.cer + .key + password) o RFC + CIEC.
# Sin estas vars el MCP corre 100% mock.
# SAT_RFC=ABC010101AA1
# SAT_CIEC=tu_password_ciec
# SAT_EFIRMA_CERT=/ruta/a/firma.cer
# SAT_EFIRMA_KEY=/ruta/a/firma.key
# SAT_EFIRMA_PASSWORD=password_efirma

# ⚠ NUNCA activar esta variable en producción sin doble revisión:
# PLUGINS_MX_SAT_PERMITIR_ESCRITURA=1


# ====================================
# Aspel COI / ContPAQi (exports CSV)
# ====================================
# Directorio donde el ERP exporta CSVs (polizas_YYYYMM.csv, balanza_YYYYMM.csv, etc.)
# ASPEL_EXPORTS_DIR=/home/usuario/contabilidad/exports


# ====================================
# WhatsApp Business (Meta Cloud API)
# ====================================
# Setup en https://business.facebook.com/
# WHATSAPP_PHONE_ID=tu_phone_number_id
# WHATSAPP_TOKEN=token_permanente_meta
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=token_que_tu_eliges
# WHATSAPP_WEBHOOK_SECRET=app_secret_para_validar_firma


# ====================================
# Directorios de cache y bitácora (opcional)
# ====================================
# Override de paths default ~/.cache/plugins-mx y ~/.local/share/plugins-mx
# PLUGINS_MX_CACHE_DIR=/tmp/plugins-mx-cache
# PLUGINS_MX_AUDIT_DIR=/tmp/plugins-mx-audit
