# ============================================================================
# plugins-mx webhooks — variables de entorno
# ============================================================================
# Copia este archivo a .env y rellena con tus secretos reales.
# .env NUNCA debe commitearse.

# --- General ---
PLUGINS_MX_WEBHOOKS_PORT=8787
PLUGINS_MX_WEBHOOKS_HOST=0.0.0.0
PLUGINS_MX_WEBHOOKS_LOG_LEVEL=info
# Si no se setea, todas las firmas se aceptan en modo MOCK (solo para tests/dev).
PLUGINS_MX_WEBHOOKS_MODE=mock

# Storage idempotencia: sqlite local | memory (in-process, tests)
PLUGINS_MX_WEBHOOKS_IDEMPOTENCY_BACKEND=sqlite
PLUGINS_MX_WEBHOOKS_IDEMPOTENCY_PATH=~/.cache/plugins-mx/webhooks/idempotency.db

# API key admin para /webhooks/recent
PLUGINS_MX_WEBHOOKS_ADMIN_KEY=cambia-este-valor-en-prod

# --- Webhook secrets por servicio ---
# Stripe (obtén en https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Mercado Pago (panel → tu app → notificaciones → webhook secret)
MERCADOPAGO_WEBHOOK_SECRET=...

# Conekta (panel → webhooks → "firma del webhook")
CONEKTA_WEBHOOK_SECRET=...

# Facturama no firma con HMAC — usa Bearer + IP allowlist
FACTURAMA_WEBHOOK_BEARER=...
FACTURAMA_WEBHOOK_ALLOWED_IPS=200.94.0.0/24,200.94.1.0/24

# Meta WhatsApp Business
META_WHATSAPP_VERIFY_TOKEN=mi-token-verificacion
META_WHATSAPP_APP_SECRET=...

# GitHub
GITHUB_WEBHOOK_SECRET=...

# Calendly
CALENDLY_WEBHOOK_SECRET=...

# Typeform
TYPEFORM_WEBHOOK_SECRET=...

# Mercado Libre (no firma con HMAC, usa Topic + IP)
MERCADOLIBRE_ALLOWED_IPS=

# Banxico CEP, IMSS Buzón, CONDUSEF — manual trigger (no firma estándar)
# Documentar IPs reales cuando se conozcan
