{
  "openapi": "3.1.0",
  "info": {
    "title": "Plugins MX — datos públicos",
    "version": "2026-10-14",
    "summary": "Archivos JSON estáticos con el catálogo y el estado real de los MCPs de Plugins MX.",
    "description": "Solo archivos JSON estáticos (GET). No hay API REST de consulta: predial, REPSE, ISN y el resto se usan como servidores MCP (Claude Code: /plugin marketplace add elimorals/Skills_MX; MCP suelto: example.mcp.json con uv). Estado real de cada MCP en /data/mcp-estado.json. Repo: https://github.com/elimorals/Skills_MX",
    "termsOfService": "https://skills-mexico.vercel.app/sobre",
    "contact": {
      "name": "Elías Rashid Morales Mendoza",
      "email": "elimoralsmendox@gmail.com",
      "url": "https://skills-mexico.vercel.app/sobre"
    },
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "https://skills-mexico.vercel.app",
      "description": "Producción"
    }
  ],
  "externalDocs": {
    "description": "Repositorio y README",
    "url": "https://github.com/elimorals/Skills_MX"
  },
  "tags": [
    {
      "name": "catalogo",
      "description": "Catálogos públicos (open data)"
    }
  ],
  "paths": {
    "/api/municipios.json": {
      "get": {
        "tags": [
          "catalogo"
        ],
        "summary": "Catálogo público de municipios con cobertura predial",
        "operationId": "listMunicipios",
        "responses": {
          "200": {
            "description": "Array de municipios catalogados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MunicipiosCatalog"
                }
              }
            }
          }
        }
      }
    },
    "/api/isn-tasas.json": {
      "get": {
        "tags": [
          "catalogo"
        ],
        "summary": "Tabla canónica de tasas ISN 2026 por entidad federativa",
        "operationId": "listIsnRates",
        "responses": {
          "200": {
            "description": "Tabla de 32 entidades con tasa, vencimiento y portal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IsnRatesTable"
                }
              }
            }
          }
        }
      }
    },
    "/api/repse-stats.json": {
      "get": {
        "tags": [
          "catalogo"
        ],
        "summary": "Estadísticas agregadas del registro REPSE",
        "operationId": "getRepseStats",
        "responses": {
          "200": {
            "description": "Stats agregados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepseStats"
                }
              }
            }
          }
        }
      }
    },
    "/data/mcp-estado.json": {
      "get": {
        "summary": "Estado real de los 83 MCPs por categoría",
        "description": "Generado por scripts/generar-estado-mcps.py desde la sección 'Estado real' de cada mcp-servers/mp_*/README.md.",
        "responses": {
          "200": {
            "description": "Estado por MCP, conteos por categoría y tools.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "tags": [
          "catalogo"
        ]
      }
    },
    "/api/skills-catalog.json": {
      "get": {
        "summary": "MCPs por categoría con estado y tools",
        "responses": {
          "200": {
            "description": "Catálogo de MCPs.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "tags": [
          "catalogo"
        ]
      }
    },
    "/api/portales-coverage.json": {
      "get": {
        "summary": "Portales por estado y dependencia, con el estado de los MCPs que los usan",
        "responses": {
          "200": {
            "description": "Cobertura de portales.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "tags": [
          "catalogo"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "MunicipiosCatalog": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "total": {
            "type": "integer"
          },
          "consultables": {
            "type": "integer"
          },
          "municipios": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Municipio"
            }
          }
        }
      },
      "Municipio": {
        "type": "object",
        "properties": {
          "estado": {
            "type": "string"
          },
          "municipio": {
            "type": "string"
          },
          "poblacion": {
            "type": "integer"
          },
          "consultable": {
            "type": "boolean"
          },
          "metodo": {
            "type": "string",
            "enum": [
              "directo",
              "sacpi",
              "captcha",
              "no-disponible"
            ]
          },
          "url_portal": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "IsnRatesTable": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "vigencia": {
            "type": "string",
            "example": "2026"
          },
          "estados": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IsnRate"
            }
          }
        }
      },
      "IsnRate": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "tasa_pct": {
            "type": "number"
          },
          "vence_dia": {
            "type": "integer"
          },
          "portal": {
            "type": "string",
            "format": "uri"
          },
          "validado_playwright": {
            "type": "boolean"
          }
        }
      },
      "RepseStats": {
        "type": "object",
        "description": "Agregación informativa del REPSE: base legal, vigencia, responsabilidad solidaria y cómo verificar con mp_repse_stps."
      }
    }
  }
}
