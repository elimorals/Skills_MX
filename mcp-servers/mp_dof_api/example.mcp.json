{
  "mcpServers": {
    "dof_api": {
      "command": "python",
      "args": ["-m", "mp_dof_api.server"],
      "env": {
        "PLUGINS_MX_MOCK": "1",
        "PLUGINS_MX_CACHE_DIR": "/tmp/plugins-mx-cache",
        "PLUGINS_MX_BITACORA_DIR": "/tmp/plugins-mx-bita"
      },
      "_notes": [
        "DOF — Diario Oficial de la Federación. 100% público, sin captcha, sin login.",
        "Validado Playwright MCP 2026-06-14 con 3 endpoints reales.",
        "Path real: MP_DOF_REAL=1 (no necesita credenciales)."
      ]
    }
  }
}
