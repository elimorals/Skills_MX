{
  "_comment": "mp_vivanuncios. Multi-categoría (autos, inmuebles, empleos, electrónica, etc.).",
  "mcpServers": {
    "vivanuncios": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_vivanuncios.server"
      ],
      "env": {
        "VIVANUNCIOS_USUARIO": "${VIVANUNCIOS_USUARIO:-}",
        "VIVANUNCIOS_PASSWORD": "${VIVANUNCIOS_PASSWORD:-}",
        "PLUGINS_MX_PLAYWRIGHT_REAL": "${PLUGINS_MX_PLAYWRIGHT_REAL:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    }
  }
}
