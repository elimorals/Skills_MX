{
  "_comment": "mp_trustly_mx (open banking MX). Sandbox: key_test_*, Producción: key_live_*.",
  "mcpServers": {
    "trustly_mx": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_trustly_mx.server"
      ],
      "env": {
        "TRUSTLY_API_KEY": "${TRUSTLY_API_KEY:-}",
        "TRUSTLY_ENV": "${TRUSTLY_ENV:-sandbox}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    }
  }
}
