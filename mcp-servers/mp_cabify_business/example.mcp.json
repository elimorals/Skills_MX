{
  "_comment": "mp_cabify_business (movilidad B2B MX).",
  "mcpServers": {
    "cabify_business": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_cabify_business.server"
      ],
      "env": {
        "CABIFY_API_KEY": "${CABIFY_API_KEY:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    }
  }
}
