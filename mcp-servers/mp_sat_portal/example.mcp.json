{
  "_comment": "Configuración para agregar mp_sat_portal a un plugin de Claude Code.6 herramientas con auth (CSF, Buzón, descarga masiva, citas, e.1 herramienta de escritura (actualizar_obligaciones) SIEMPRE retorna simulación por seguridad. Path real con Playwright + e.firma no incluido en esta versión.",
  "mcpServers": {
    "sat_portal": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers[sat-ws,sat-portal] @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_sat_portal.server"
      ],
      "env": {
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}",
        "SAT_RFC": "${SAT_RFC:-}",
        "SAT_CIEC": "${SAT_CIEC:-}",
        "SAT_EFIRMA_CERT": "${SAT_EFIRMA_CERT:-}",
        "SAT_EFIRMA_KEY": "${SAT_EFIRMA_KEY:-}",
        "SAT_EFIRMA_PASSWORD": "${SAT_EFIRMA_PASSWORD:-}"
      },
      "disabled": false
    }
  }
}
