{
  "mcpServers": {
    "impi_marcanet": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_impi_marcanet.server"
      ],
      "env": {
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}",
        "PLUGINS_MX_CACHE_DIR": "/tmp/plugins-mx-cache",
        "PLUGINS_MX_BITACORA_DIR": "/tmp/plugins-mx-bita"
      },
      "_notes": [
        "Portal: https://vidoc.impi.gob.mx/busc (reemplazó MARCANET).",
        "Modo real requiere Playwright + reCAPTCHA v3 emission.",
        "Set PLUGINS_MX_IMPI_LIVE=1 y `pip install playwright && playwright install chromium`.",
        "Universo: legaltech, agencias creativas, startups, marketplaces."
      ]
    }
  }
}
