{
  "mcpServers": {
    "agua_mx": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_agua_mx.server"
      ],
      "env": {
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}",
        "PLUGINS_MX_CACHE_DIR": "/tmp/plugins-mx-cache",
        "PLUGINS_MX_BITACORA_DIR": "/tmp/plugins-mx-bita"
      },
      "_notes": [
        "Catálogo unificado de 12 organismos top (50% pob urbana).",
        "Mock-first; PLUGINS_MX_AGUA_LIVE=1 activa Playwright real (por implementar por organismo).",
        "Universo: 33M hogares × consulta bimestral."
      ]
    }
  }
}
