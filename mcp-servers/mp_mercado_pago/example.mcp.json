{
  "_comment": "Ejemplo de configuración para agregar mp_mercado_pago a un plugin de Claude Code. Copiar a <plugin>/.mcp.json o fusionar con mcpServers existente.",
  "mcpServers": {
    "mercadopago": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_mercado_pago.server"
      ],
      "env": {
        "MERCADOPAGO_ACCESS_TOKEN": "${MERCADOPAGO_ACCESS_TOKEN:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    }
  }
}
