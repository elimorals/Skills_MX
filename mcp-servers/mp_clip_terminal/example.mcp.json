{
  "_comment": "mp_clip_terminal (POS Clip MX).",
  "mcpServers": {
    "clip_terminal": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_clip_terminal.server"
      ],
      "env": {
        "CLIP_API_KEY": "${CLIP_API_KEY:-}",
        "CLIP_SECRET_KEY": "${CLIP_SECRET_KEY:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    }
  }
}
