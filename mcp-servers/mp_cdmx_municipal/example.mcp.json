{
  "_comment": "mp_cdmx_municipal (Finanzas CDMX + SEMOVI). Predial y tenencia son consultas, multas requieren scraping de portal con captcha.",
  "mcpServers": {
    "cdmx_municipal": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_cdmx_municipal.server"
      ],
      "env": {
        "CDMX_USUARIO": "${CDMX_USUARIO:-}",
        "CDMX_PASSWORD": "${CDMX_PASSWORD:-}",
        "PLUGINS_MX_PLAYWRIGHT_REAL": "${PLUGINS_MX_PLAYWRIGHT_REAL:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    }
  }
}
