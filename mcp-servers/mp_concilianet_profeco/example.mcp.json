{
  "mcpServers": {
    "concilianet": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers[publicos-federales-2] @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_concilianet_profeco.server"
      ],
      "env": {
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      }
    }
  }
}
