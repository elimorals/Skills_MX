{
  "mcpServers": {
    "tenencia_mx": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_tenencia_mx.server"
      ],
      "env": {
        "PLUGINS_MX_CACHE_DIR": "/tmp/plugins-mx-cache",
        "PLUGINS_MX_BITACORA_DIR": "/tmp/plugins-mx-bita"
      },
      "_notes": [
        "Catálogo de 20 estados MX con costos vigentes 2026.",
        "Cálculo OFFLINE — no requiere credenciales ni red.",
        "Universo: 46M vehículos × cálculo anual. Útil para flotillas, leasing, comparación re-emplaque."
      ]
    }
  }
}
