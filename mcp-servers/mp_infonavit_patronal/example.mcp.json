{
  "_comment": "mp_infonavit_patronal (Portal Empresarial INFONAVIT). Path real no implementado.",
  "mcpServers": {
    "infonavit_patronal": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_infonavit_patronal.server"
      ],
      "env": {
        "INFONAVIT_RFC_PATRONAL": "${INFONAVIT_RFC_PATRONAL:-}",
        "INFONAVIT_USUARIO": "${INFONAVIT_USUARIO:-}",
        "INFONAVIT_PASSWORD": "${INFONAVIT_PASSWORD:-}",
        "PLUGINS_MX_PLAYWRIGHT_REAL": "${PLUGINS_MX_PLAYWRIGHT_REAL:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    }
  }
}
