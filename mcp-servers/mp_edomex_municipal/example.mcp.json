{
  "_comment": "mp_edomex_municipal. EdoMex tiene multiple portales por municipio.",
  "mcpServers": {
    "edomex_municipal": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers[estatal-centro] @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_edomex_municipal.server"
      ],
      "env": {
        "EDOMEX_USUARIO": "${EDOMEX_USUARIO:-}",
        "EDOMEX_PASSWORD": "${EDOMEX_PASSWORD:-}",
        "PLUGINS_MX_PLAYWRIGHT_REAL": "${PLUGINS_MX_PLAYWRIGHT_REAL:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    }
  }
}
