{
  "_comment": "Configuración mp_bancos_mx. Path Playwright real NO implementado. Para usar real (a futuro): credenciales por banco (BBVA_USUARIO, BBVA_PASSWORD, etc.) + PLUGINS_MX_PLAYWRIGHT_REAL=1 + parser específico del portal mantenido al día.",
  "mcpServers": {
    "bancos_mx": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_bancos_mx.server"
      ],
      "env": {
        "BANCOS_MX_USUARIO": "${BANCOS_MX_USUARIO:-}",
        "BANCOS_MX_PASSWORD": "${BANCOS_MX_PASSWORD:-}",
        "BBVA_USUARIO": "${BBVA_USUARIO:-}",
        "BBVA_PASSWORD": "${BBVA_PASSWORD:-}",
        "BANAMEX_USUARIO": "${BANAMEX_USUARIO:-}",
        "BANAMEX_PASSWORD": "${BANAMEX_PASSWORD:-}",
        "PLUGINS_MX_PLAYWRIGHT_REAL": "${PLUGINS_MX_PLAYWRIGHT_REAL:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    }
  }
}
