{
  "mcpServers": {
    "repuve": {
      "command": "python",
      "args": ["-m", "mp_repuve.server"],
      "env": {
        "PLUGINS_MX_MOCK": "1",
        "PLUGINS_MX_CACHE_DIR": "/tmp/plugins-mx-cache",
        "PLUGINS_MX_BITACORA_DIR": "/tmp/plugins-mx-bita"
      },
      "_notes": [
        "Portal: https://www2.repuve.gob.mx:8443/ciudadania/ — Angular SPA + reCAPTCHA v3.",
        "Para path real: PLUGINS_MX_REPUVE_LIVE=1 + pip install playwright && playwright install chromium.",
        "Universo: aseguradoras, movilidad (Uber/DiDi), Kavak-like, leasing.",
        "Endpoint exacto pendiente captura — ver shared/repuve.py::API_URL_PATTERN."
      ]
    }
  }
}
