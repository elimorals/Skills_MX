{
  "_comment": "Ejemplo de configuración para agregar mp_mercado_libre a un plugin de Claude Code. Copiar a <plugin>/.mcp.json o fusionar con mcpServers existente.",
  "mcpServers": {
    "mercadolibre": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_mercado_libre.server"
      ],
      "env": {
        "ML_APP_ID": "${ML_APP_ID:-}",
        "ML_SECRET": "${ML_SECRET:-}",
        "ML_REFRESH_TOKEN": "${ML_REFRESH_TOKEN:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    }
  }
}
