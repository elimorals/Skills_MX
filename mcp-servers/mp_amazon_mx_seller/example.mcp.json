{
  "_comment": "mp_amazon_mx_seller (Amazon MX Selling Partner API). Path real requiere LWA + AWS Sig V4 (~80-120h dev). Marketplace ID MX: A1AM78C64UM0Y8.",
  "mcpServers": {
    "amazon_mx_seller": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_amazon_mx_seller.server"
      ],
      "env": {
        "AMAZON_SP_REFRESH_TOKEN": "${AMAZON_SP_REFRESH_TOKEN:-}",
        "AMAZON_SP_CLIENT_ID": "${AMAZON_SP_CLIENT_ID:-}",
        "AMAZON_SP_CLIENT_SECRET": "${AMAZON_SP_CLIENT_SECRET:-}",
        "AMAZON_SP_SELLER_ID": "${AMAZON_SP_SELLER_ID:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    }
  }
}
