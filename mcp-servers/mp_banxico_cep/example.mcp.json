{
  "_comment": "Configuración para agregar mp_banxico_cep a un plugin de Claude Code. Las 4 herramientas locales (CLABE, parseo clave rastreo, lookup banco) son SIEMPRE reales.",
  "mcpServers": {
    "banxico_cep": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_banxico_cep.server"
      ],
      "env": {
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}",
        "BANXICO_CEP_PLAYWRIGHT": "${BANXICO_CEP_PLAYWRIGHT:-}"
      },
      "disabled": false
    }
  }
}
