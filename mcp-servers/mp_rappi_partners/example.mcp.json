{
  "mcpServers": {
    "rappi_partners": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_rappi_partners.server"
      ],
      "env": {
        "RAPPI_CLIENT_ID": "${RAPPI_CLIENT_ID:-}",
        "RAPPI_CLIENT_SECRET": "${RAPPI_CLIENT_SECRET:-}",
        "RAPPI_STORE_ID": "${RAPPI_STORE_ID:-}",
        "RAPPI_ENV": "${RAPPI_ENV:-mx}"
      }
    }
  }
}
