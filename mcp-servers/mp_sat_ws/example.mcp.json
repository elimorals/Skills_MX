{
  "mcpServers": {
    "sat_ws": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers[sat-ws] @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_sat_ws.server"
      ],
      "env": {
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}",
        "PLUGINS_MX_CACHE_DIR": "/tmp/plugins-mx-cache",
        "PLUGINS_MX_BITACORA_DIR": "/tmp/plugins-mx-bita"
      },
      "_notes": [
        "Web Service SOAP oficial SAT — requiere e.firma vigente.",
        "Para path real: SAT_EFIRMA_CERT, SAT_EFIRMA_KEY, SAT_EFIRMA_PASSWORD.",
        "Universo: despacho-contable (200+ clientes), ERPs (Aspel/Contpaqi), auditoría.",
        "Modo real: quita PLUGINS_MX_MOCK e instala el extra [sat-ws] (cryptography)."
      ]
    }
  }
}
