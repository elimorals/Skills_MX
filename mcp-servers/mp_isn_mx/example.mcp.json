{
  "mcpServers": {
    "isn_mx": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_isn_mx.server"
      ],
      "env": {
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}",
        "PLUGINS_MX_CACHE_DIR": "/tmp/plugins-mx-cache",
        "PLUGINS_MX_BITACORA_DIR": "/tmp/plugins-mx-bita"
      },
      "_notes": [
        "Multi-estado: CDMX, JAL, NL, EdoMex, QRO, PUE, GTO, YUC, BC validados.",
        "Universo: TODA empresa formal MX con trabajadores (~4M empresas).",
        "Path real requiere credenciales por estado + MP_PLAYWRIGHT_PUBLIC=1."
      ]
    }
  }
}
