{
  "mcpServers": {
    "sacpi_michoacan": {
      "_comment": "SACPI Michoacán. Estado y cobertura: README del MCP, sección 'Estado real'.",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_sacpi_michoacan.server"
      ],
      "env": {
        "MP_PLAYWRIGHT_PUBLIC": "0",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      }
    }
  }
}
