{
  "_comment": "Configuración mp_shopify_mx. Para path real: en Shopify Admin > Apps > Develop apps > Crear app privada con permisos products/inventory/orders/customers/webhooks. Copiar access token (empieza con 'shpat_').",
  "mcpServers": {
    "shopify_mx": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_shopify_mx.server"
      ],
      "env": {
        "SHOPIFY_SHOP": "${SHOPIFY_SHOP:-}",
        "SHOPIFY_ACCESS_TOKEN": "${SHOPIFY_ACCESS_TOKEN:-}",
        "SHOPIFY_API_VERSION": "${SHOPIFY_API_VERSION:-2024-10}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    }
  }
}
