{
  "mcpServers": {
    "kueski": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_kueski.server"
      ],
      "env": {
        "KUESKI_API_KEY": "${{ KUESKI_API_KEY:- }}"
      }
    }
  }
}
