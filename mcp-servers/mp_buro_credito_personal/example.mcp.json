{
  "_comment": "⚠ mp_buro_credito_personal. OPERACIÓN LEGALMENTE SENSIBLE. Toda consulta requiere autorización formal del titular. Sin token de autorización válido (firma digital, click-wrap, carta firmada) las tools fallan por compliance independientemente del modo.",
  "mcpServers": {
    "buro_credito_personal": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_buro_credito_personal.server"
      ],
      "env": {
        "BURO_API_KEY": "${BURO_API_KEY:-}",
        "BURO_USUARIO": "${BURO_USUARIO:-}",
        "BURO_PASSWORD": "${BURO_PASSWORD:-}",
        "PLUGINS_MX_PLAYWRIGHT_REAL": "${PLUGINS_MX_PLAYWRIGHT_REAL:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    }
  }
}
