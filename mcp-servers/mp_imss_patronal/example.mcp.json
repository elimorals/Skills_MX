{
  "_comment": "mp_imss_patronal (IMSS Desde su Empresa). Path real requiere e.firma o NPIE — no implementado todavía.",
  "mcpServers": {
    "imss_patronal": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_imss_patronal.server"
      ],
      "env": {
        "IMSS_RFC_PATRONAL": "${IMSS_RFC_PATRONAL:-}",
        "IMSS_NPIE_PATH": "${IMSS_NPIE_PATH:-}",
        "IMSS_EFIRMA_CERT": "${IMSS_EFIRMA_CERT:-}",
        "PLUGINS_MX_PLAYWRIGHT_REAL": "${PLUGINS_MX_PLAYWRIGHT_REAL:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    }
  }
}
