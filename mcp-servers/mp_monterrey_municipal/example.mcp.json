{
  "_comment": "mp_monterrey_municipal. Cubre área metropolitana de Monterrey (9 municipios).",
  "mcpServers": {
    "monterrey_municipal": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_monterrey_municipal.server"
      ],
      "env": {
        "NL_USUARIO": "${NL_USUARIO:-}",
        "NL_PASSWORD": "${NL_PASSWORD:-}",
        "PLUGINS_MX_PLAYWRIGHT_REAL": "${PLUGINS_MX_PLAYWRIGHT_REAL:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    }
  }
}
