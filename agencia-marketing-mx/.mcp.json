{
  "_comment": "MCP servers para agencia-marketing-mx. banxico activo por default; el resto requiere credenciales.",
  "mcpServers": {
    "banxico": {
      "_comment": "Tipos de cambio DOF para cotizaciones a clientes con facturación en USD (campañas internacionales).",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--with",
        "plugins-mx-mcp-servers @ git+https://github.com/elimorals/Skills_MX@main#subdirectory=mcp-servers",
        "python",
        "-m",
        "mp_banxico.server"
      ],
      "env": {
        "BANXICO_TOKEN": "${BANXICO_TOKEN:-}",
        "PLUGINS_MX_MOCK": "${PLUGINS_MX_MOCK:-}"
      },
      "disabled": false
    },
    "ga4": {
      "_comment": "Google Analytics 4 Data API.",
      "command": "uvx",
      "args": [
        "analytics-mcp"
      ],
      "disabled": true,
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS:-}",
        "GOOGLE_PROJECT_ID": "${GOOGLE_PROJECT_ID:-}"
      }
    }
  }
}
