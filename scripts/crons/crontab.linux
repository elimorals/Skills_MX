# crontab.linux — versión Linux/WSL de los crons del monorepo plugins-mx
#
# INSTALAR:
#    crontab -l > /tmp/cron-backup
#    crontab scripts/crons/crontab.linux
#
# VERIFICAR:
#    crontab -l
#
# Ajustar PATH_REPO con la ruta real del repo.

PATH_REPO=/Users/elias/Documents/Trabajo/skills
SHELL=/bin/bash
LOG_DIR=/tmp

# ────────────────── Universales (originales — 2 activos) ──────────────────

# Refresh tipos de cambio Banxico — L-V 10:00
0 10 * * 1-5 cd $PATH_REPO && bash scripts/refresh-banxico-tcs.sh >> $LOG_DIR/plugins-mx-banxico-tcs.log 2>&1

# Refresh listas 69 y 69-B SAT — lunes 09:00
0 9 * * 1 cd $PATH_REPO && bash scripts/refresh-sat-listas-69.sh >> $LOG_DIR/plugins-mx-sat-listas.log 2>&1

# ────────────────── Cobranza recurrente (3 nuevos) ──────────────────

# Arranque cobranza mensual — día 1 a las 09:00
0 9 1 * * cd $PATH_REPO && bash scripts/crons/cobranza-recurrente.sh >> $LOG_DIR/plugins-mx-cobranza.log 2>&1

# Verificar cobros del mes — día 5 a las 10:00
0 10 5 * * cd $PATH_REPO && bash scripts/crons/verificar-cobros.sh >> $LOG_DIR/plugins-mx-verificar.log 2>&1

# ────────────────── Fiscal (3 nuevos) ──────────────────

# Pre-cierre fiscal — día 14 a las 09:00
0 9 14 * * cd $PATH_REPO && bash scripts/crons/pre-cierre-fiscal.sh >> $LOG_DIR/plugins-mx-pre-cierre.log 2>&1

# Alerta pago provisional — día 15 a las 10:00
0 10 15 * * cd $PATH_REPO && bash scripts/crons/alerta-pago-provisional.sh >> $LOG_DIR/plugins-mx-alerta-prov.log 2>&1

# Última alerta deadline — día 17 a las 08:00
0 8 17 * * cd $PATH_REPO && bash scripts/crons/ultima-alerta-deadline.sh >> $LOG_DIR/plugins-mx-deadline.log 2>&1

# ────────────────── Dashboards y backup (2 nuevos) ──────────────────

# Dashboard semanal — lunes 09:30 (tras refresh listas)
30 9 * * 1 cd $PATH_REPO && bash scripts/crons/dashboard-semanal.sh >> $LOG_DIR/plugins-mx-dashboard.log 2>&1

# Backup semanal — viernes 18:00
0 18 * * 5 cd $PATH_REPO && bash scripts/crons/backup-semanal.sh >> $LOG_DIR/plugins-mx-backup.log 2>&1

# ────────────────── Operativo continuo (2 nuevos) ──────────────────

# Check WhatsApp pendientes — cada 30min L-V 9-18
*/30 9-18 * * 1-5 cd $PATH_REPO && bash scripts/crons/check-wa-pendientes.sh >> $LOG_DIR/plugins-mx-wa.log 2>&1

# Check multas vehiculares — diario 08:00
0 8 * * * cd $PATH_REPO && bash scripts/crons/check-multas-vehiculares.sh >> $LOG_DIR/plugins-mx-multas.log 2>&1

# ────────────────── Crons específicos por vertical (19) ──────────────────

# Vehicular
0 8 1 * * cd $PATH_REPO && bash scripts/crons/renovacion-licencia-conducir.sh >> $LOG_DIR/plugins-mx-licencias.log 2>&1
30 8 1 * * cd $PATH_REPO && bash scripts/crons/verificacion-vehicular-proxima.sh >> $LOG_DIR/plugins-mx-verifica.log 2>&1
0 9 2 1 * cd $PATH_REPO && bash scripts/crons/refrendo-tenencia-enero.sh >> $LOG_DIR/plugins-mx-refrendo.log 2>&1

# Airbnb / Hospedaje
0 9 10 * * cd $PATH_REPO && bash scripts/crons/ish-mensual-airbnb-host.sh >> $LOG_DIR/plugins-mx-ish.log 2>&1

# Nómina
0 9 12 * * cd $PATH_REPO && bash scripts/crons/imss-pia-mensual.sh >> $LOG_DIR/plugins-mx-imss.log 2>&1

# Hipotecaria
0 9 1 11 * cd $PATH_REPO && bash scripts/crons/deadline-prepago-hipoteca.sh >> $LOG_DIR/plugins-mx-prepago.log 2>&1

# Seguros
0 9 * * * cd $PATH_REPO && bash scripts/crons/polizas-seguros-renovacion-90d.sh >> $LOG_DIR/plugins-mx-polizas.log 2>&1

# Arrendamiento
30 9 1 * * cd $PATH_REPO && bash scripts/crons/cobranza-renta-mensual.sh >> $LOG_DIR/plugins-mx-renta.log 2>&1

# Construcción
0 9 8 * * cd $PATH_REPO && bash scripts/crons/repse-mensual-construccion.sh >> $LOG_DIR/plugins-mx-repse.log 2>&1

# Fiscal
0 9 * * 1 cd $PATH_REPO && bash scripts/crons/efirma-vencimiento-90d.sh >> $LOG_DIR/plugins-mx-efirma.log 2>&1
0 9 1 3 * cd $PATH_REPO && bash scripts/crons/cierre-fiscal-anual-marzo.sh >> $LOG_DIR/plugins-mx-anual.log 2>&1
15 9 * * 1 cd $PATH_REPO && bash scripts/crons/sat-listas-69b-semanal.sh >> $LOG_DIR/plugins-mx-69b.log 2>&1

# Marketing / Agencia
0 10 * * * cd $PATH_REPO && bash scripts/crons/templates-wa-status-meta.sh >> $LOG_DIR/plugins-mx-wa-templates.log 2>&1
0 9 2 * * cd $PATH_REPO && bash scripts/crons/reporte-cliente-agencia-mensual.sh >> $LOG_DIR/plugins-mx-reporte-agencia.log 2>&1

# Geriatría
30 7 * * * cd $PATH_REPO && bash scripts/crons/medicamentos-vencimiento-residentes.sh >> $LOG_DIR/plugins-mx-medicamentos.log 2>&1

# Laboratorio clínico
0 10 3 * * cd $PATH_REPO && bash scripts/crons/comisiones-medicos-mensual.sh >> $LOG_DIR/plugins-mx-comisiones-lab.log 2>&1
0 9 1 1,4,7,10 * cd $PATH_REPO && bash scripts/crons/cofepris-vencimientos.sh >> $LOG_DIR/plugins-mx-cofepris.log 2>&1

# Restaurante
0 22 * * 1,5 cd $PATH_REPO && bash scripts/crons/inventario-merma-restaurante.sh >> $LOG_DIR/plugins-mx-merma.log 2>&1

# Ecommerce
0 */2 * * 1-5 cd $PATH_REPO && bash scripts/crons/sync-inventario-ecommerce.sh >> $LOG_DIR/plugins-mx-sync-ec.log 2>&1

# Anual SAT — devoluciones
0 11 * * 1-5 cd $PATH_REPO && bash scripts/crons/devolucion-sat-anual-seguimiento.sh >> $LOG_DIR/plugins-mx-devolucion.log 2>&1
